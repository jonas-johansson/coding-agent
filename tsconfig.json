{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    // TypeScript 6.0 no longer auto-includes node_modules/@types — list explicitly.
    "types": ["node", "turndown"]
  },
  "include": [
    "src/**/*"
  ]
}
